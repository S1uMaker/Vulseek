FROM ubuntu:24.04 AS tools

ARG DEBIAN_FRONTEND=noninteractive
ARG CODEQL_VERSION="2.26.3"
ARG RUST_TOOLCHAIN="stable"
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    http_proxy=$http_proxy \
    https_proxy=$https_proxy \
    no_proxy=$no_proxy \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
    RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup

RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.ustc.edu.cn/ubuntu/|g; s|http://security.ubuntu.com/ubuntu/|http://mirrors.ustc.edu.cn/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources

RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf '%s\n' 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
      > /etc/apt/apt.conf.d/keep-cache

RUN --mount=type=cache,id=vulseek-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=vulseek-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git jq unzip zip tar xz-utils file gnupg \
    openssl libssl3t64 \
    openssh-client ripgrep vim nano less rsync tree \
    build-essential cmake ninja-build make autoconf automake libtool pkg-config \
    patch \
    clang clangd lldb lld libclang-rt-18-dev gdb \
    python3 python3-pip python3-venv \
    pipx \
    software-properties-common

RUN printf '%s\n' 'int main(void){char a[1]; a[0]=0; return 0;}' > /tmp/vulseek-sanitize-smoke.c \
    && clang -O1 -g -fsanitize=address,undefined,pointer-overflow \
      /tmp/vulseek-sanitize-smoke.c -o /tmp/vulseek-sanitize-smoke \
    && /tmp/vulseek-sanitize-smoke \
    && rm -f /tmp/vulseek-sanitize-smoke.c /tmp/vulseek-sanitize-smoke

RUN sed -i 's|http://mirrors.ustc.edu.cn/ubuntu/|https://mirrors.ustc.edu.cn/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources

ENV PATH="/root/.cargo/bin:$PATH"
RUN --mount=type=cache,id=vulseek-rustup-downloads,target=/root/.rustup/downloads,sharing=locked \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && mkdir -p "${CARGO_HOME}" \
    && printf '%s\n' \
      '[source.crates-io]' \
      'replace-with = "tuna"' \
      '' \
      '[source.tuna]' \
      'registry = "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/"' \
      '' \
      '[registries.tuna]' \
      'index = "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/"' \
      > "${CARGO_HOME}/config.toml"
RUN rustc --version && cargo --version

RUN --mount=type=cache,id=vulseek-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=vulseek-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && node --version \
    && node -e "if (Number(process.versions.node.split('.')[0]) < 22) process.exit(1)" \
    && npm --version

RUN python3 -m pip config set global.index-url "$PIP_INDEX_URL" \
    && python3 -m pip config set global.trusted-host "$PIP_TRUSTED_HOST"
RUN --mount=type=cache,id=vulseek-pip-cache,target=/root/.cache/pip,sharing=locked \
    PIPX_BIN_DIR=/usr/local/bin pipx install semgrep \
    && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy semgrep --version

RUN --mount=type=cache,id=vulseek-pip-cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv /opt/vulseek-venv \
    && /opt/vulseek-venv/bin/pip install --upgrade pip \
	    && /opt/vulseek-venv/bin/pip install \
	      requests \
	      jsonschema \
	      'psycopg[binary]>=3.2,<4' \
	      tree-sitter \
      tree-sitter-c \
      tree-sitter-cpp

ENV PATH="/opt/vulseek-venv/bin:$PATH"

RUN --mount=type=cache,id=vulseek-npm-cache,target=/root/.npm,sharing=locked \
    npm config set registry https://registry.npmmirror.com \
    && npm config get registry
RUN --mount=type=cache,id=vulseek-npm-cache,target=/root/.npm,sharing=locked \
    npm install -g @anthropic-ai/claude-code || true
RUN --mount=type=cache,id=vulseek-npm-cache,target=/root/.npm,sharing=locked \
    npm install -g skills@1.5.10 \
    && command -v skills >/dev/null \
    && command -v add-skill >/dev/null \
    && node -e "const p=require(require('child_process').execSync('npm root -g').toString().trim() + '/skills/package.json'); if (p.version !== '1.5.10') process.exit(1)"
RUN --mount=type=cache,id=vulseek-npm-cache,target=/root/.npm,sharing=locked \
    npm install -g @openai/codex \
    && codex --version

COPY codex-acp-fork-1.3.0.patch /tmp/vulseek-codex-acp-fork.patch
RUN --mount=type=cache,id=vulseek-npm-cache,target=/root/.npm,sharing=locked \
    npm config set registry https://registry.npmjs.org \
    && npm config get registry \
	    && npm install -g ccusage@20.0.20 \
	    && command -v ccusage >/dev/null \
	    && ccusage --help >/dev/null \
	    && npm install --prefix /opt/vulseek-acp \
	      @agentclientprotocol/sdk@1.3.0 \
	      @agentclientprotocol/codex-acp@1.3.0 \
	      @agentclientprotocol/claude-agent-acp@0.68.0 \
	    && chmod 0755 /opt/vulseek-acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js \
	    && patch -d /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp \
      -p1 < /tmp/vulseek-codex-acp-fork.patch \
    && grep -F 'fork: {}' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
    && grep -F 'method: "thread/fork"' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
    && grep -F 'sessionUpdate: "session_info_update"' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
    && grep -F 'createTurnSessionInfoUpdate' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
    && grep -F 'turn: { status: "completed" }' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
    && grep -F 'createTaskCompletedSessionInfoUpdate' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && grep -F 'task: { status: "completed" }' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && ! grep -F 'requires goal text of at most 4000 characters' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && grep -F 'const fullObjective = objective.length > 4e3 ? objective : null' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && grep -F 'await this.steerTurn({' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && grep -F 'await onGoalTurnStarted?.(turnId)' /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js >/dev/null \
	    && test -f /opt/vulseek-acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/acp-agent.js \
    && test -f /opt/vulseek-acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/goal-extension.js \
    && node --check /opt/vulseek-acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/acp-agent.js \
    && node --check /opt/vulseek-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js \
    && rm -f /tmp/vulseek-codex-acp-fork.patch
COPY vulseek-acp-driver.mjs agent-events.mjs /opt/vulseek-acp/
RUN chmod 0755 /opt/vulseek-acp/vulseek-acp-driver.mjs \
    && node --check /opt/vulseek-acp/vulseek-acp-driver.mjs \
    && node --check /opt/vulseek-acp/agent-events.mjs \
    && test -x /opt/vulseek-acp/node_modules/.bin/codex-acp \
    && test -x /opt/vulseek-acp/node_modules/.bin/claude-agent-acp
ENV PATH="/opt/vulseek-acp/node_modules/.bin:$PATH"

# Grok Build native ACP: `grok agent stdio`.
# BuildKit does not inherit the client HTTP_PROXY unless it is passed as
# --build-arg (see getDockerBuildEnvironmentPairs). Without that, curl talks
# to x.ai:443 directly and times out.
RUN echo "[vulseek] installing grok CLI HTTP_PROXY=${HTTP_PROXY:-<empty>}" \
    && curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 30 --max-time 120 \
      https://x.ai/cli/install.sh -o /tmp/grok-install.sh \
    && bash /tmp/grok-install.sh \
    && rm -f /tmp/grok-install.sh \
    && if [ -x /root/.grok/bin/grok ]; then install -m 0755 /root/.grok/bin/grok /usr/local/bin/grok; fi \
    && command -v grok >/dev/null \
    && grok --version

ENV PATH="/root/.local/bin:$PATH" \
    UV_TOOL_BIN_DIR="/usr/local/bin"
RUN --mount=type=cache,id=vulseek-uv-cache,target=/root/.cache/uv,sharing=locked \
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh \
    && uv --version \
    && uv tool install -p 3.13 serena-agent@latest --prerelease=allow \
    && ln -sf "$(uv tool dir)/serena-agent/bin/serena" /usr/local/bin/serena \
    && mkdir -p /root/.serena \
    && serena init -b LSP \
    && if command -v codex >/dev/null; then serena setup codex || true; fi \
    && if command -v claude >/dev/null; then serena setup claude-code || true; fi \
    && sed -i 's#^ls_specific_settings: {}#ls_specific_settings:\n  cpp:\n    ls_path: "/opt/vulseek/clangd-wrapper"#' /root/.serena/serena_config.yml \
    && sed -i 's#^ignored_paths: \[\]#ignored_paths:\n- "/scan-context"\n- "/scan-context/**"#' /root/.serena/serena_config.yml \
    && sed -i 's#^project_serena_folder_location:.*#project_serena_folder_location: "/scan-context/.serena"#' /root/.serena/serena_config.yml \
    && command -v serena >/dev/null

RUN mkdir -p /opt/vulseek \
    && printf '%s\n' \
      '#!/bin/bash' \
      'args=()' \
      'for arg in "$@"; do' \
      '    [ "$arg" = "--background-index" ] && continue' \
      '    args+=("$arg")' \
      'done' \
      'exec /usr/bin/clangd --background-index=0 "${args[@]}"' \
      > /opt/vulseek/clangd-wrapper \
    && chmod 0755 /opt/vulseek/clangd-wrapper

RUN --mount=type=cache,id=vulseek-codeql-downloads,target=/root/.cache/vulseek-codeql,sharing=locked \
    mkdir -p /opt/codeql \
    && if [ -s "/root/.cache/vulseek-codeql/codeql-linux64-${CODEQL_VERSION}.zip" ] \
      && unzip -tq "/root/.cache/vulseek-codeql/codeql-linux64-${CODEQL_VERSION}.zip" >/dev/null 2>&1; then \
      :; \
    else \
      rm -f "/root/.cache/vulseek-codeql/codeql-linux64-${CODEQL_VERSION}.zip" \
      && curl --fail --location --retry 3 \
        "https://github.com/github/codeql-cli-binaries/releases/download/v${CODEQL_VERSION}/codeql-linux64.zip" \
        -o "/root/.cache/vulseek-codeql/codeql-linux64-${CODEQL_VERSION}.zip"; \
    fi \
    && unzip -q "/root/.cache/vulseek-codeql/codeql-linux64-${CODEQL_VERSION}.zip" -d /opt \
    && ln -sf /opt/codeql/codeql /usr/local/bin/codeql
RUN codeql pack download codeql/cpp-all

FROM tools AS final

ARG VULSEEK_TOOLS_VERSION
ARG VULSEEK_TOOLS_BUILT_AT
ARG VULSEEK_TOOLS_VARIANT
LABEL com.fuzzing-peach.vulseek.scan-tools.version="${VULSEEK_TOOLS_VERSION}" \
      com.fuzzing-peach.vulseek.scan-tools.built-at="${VULSEEK_TOOLS_BUILT_AT}" \
      com.fuzzing-peach.vulseek.scan-tools.variant="${VULSEEK_TOOLS_VARIANT}" \
      com.fuzzing-peach.vulseek.scan-tools.format="1"

WORKDIR /workspace
CMD ["/bin/bash"]
