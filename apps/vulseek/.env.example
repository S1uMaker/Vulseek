DATABASE_URL="postgres://vulseek:amukds4wi9001583845717ad2@localhost:5432/vulseek"
# BullMQ connection. Without it the dev server falls back to the Swarm-internal
# hostname "vulseek-redis-dev", which is unreachable when the server runs on
# the host instead of inside the Swarm network.
REDIS_URL="redis://127.0.0.1:6379"
# Host directory bound into scan containers as /scan-context (job artifacts,
# checkouts). dev.sh sets this to ./vulseek-data-dev; required for bare
# `pnpm vulseek:dev` runs too, otherwise starting a scan throws.
VULSEEK_SCAN_CONTEXT_HOST_PATH=/home/urgot/fuzz/Vulseek/vulseek-data-dev
# HMAC secret used to issue per-job runtime API tokens. Without it the agent
# containers get no VULSEEK_RUNTIME_API_URL/TOKEN and every submit-message
# fails. Generate with: openssl rand -hex 32
VULSEEK_RUNTIME_API_SECRET=change-me-openssl-rand-hex-32
# How agent containers reach the runtime API served by the dev server.
# Bare-metal dev: http://host.docker.internal:3000 (dev.sh omits this and the
# containers resolve the in-network service name vulseek:3000 instead).
VULSEEK_RUNTIME_API_URL=http://host.docker.internal:3000
PORT=3000
NODE_ENV=development
# VULSEEK_DEV_AUTH_BYPASS=1
